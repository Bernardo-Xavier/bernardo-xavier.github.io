---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 5);
---
<Base>
  <section class="hero wrap">
    <p class="kicker">Brazil → Canada · {SITE.place}</p>
    <h1>{SITE.name}<br /><span class="accent">{SITE.role}</span></h1>
    <p>{SITE.tagline}</p>
    <div class="links">
      <a class="button primary" href="/blog/">Read the blog</a>
      <a class="button" href="/projects/">See projects</a>
      <a class="button" href={SITE.links.github}>GitHub</a>
    </div>
  </section>
  <section class="wrap">
    <h2>Latest posts</h2>
    <PostList posts={posts} />
  </section>
</Base>
